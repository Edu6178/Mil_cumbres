APP_NAME="Mil Cumbres"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Completar en el servidor con una cuenta real de WhatsApp Business y su plantilla aprobada.
WHATSAPP_API_HABILITADA=false
WHATSAPP_TOKEN=
WHATSAPP_TELEFONO_ID=
WHATSAPP_API_VERSION=v27.0
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=es_MX
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Completa estos datos cuando tengas lista tu base de PostgreSQL.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mil_cumbres
DB_USERNAME=mil_cumbres_user
DB_PASSWORD=

# Guarda las sesiones en archivos mientras se configura la base de datos.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# IDs de administradores existentes para el arranque de roles (el primero será superadministrador).
# En APP_ENV=local, php artisan migrate --seed crea la cuenta de prueba y agrega aquí su ID real.
ADMIN_USUARIOS=

# Activa expresamente el escenario ficticio en el VPS de presentación; no crea administradores.
DEMOSTRACION_HABILITADA=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
